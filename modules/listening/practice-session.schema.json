{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal PracticeSession (solutions stay on server)",
  "type": "object",
  "required": ["id", "settings", "passage", "questions"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "settings": {
      "type": "object",
      "required": ["difficulty", "question_count", "target_wpm"],
      "properties": {
        "difficulty": { "enum": ["CET-4", "CET-6", "TEM-8"] },
        "question_count": { "type": "integer", "minimum": 1, "maximum": 4 },
        "target_wpm": { "type": "integer", "minimum": 120, "maximum": 220 },
        "topic": { "type": "string", "maxLength": 120 }
      }
    },
    "passage": {
      "type": "object", "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 10000 } }
    },
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "type", "question", "options", "correct_answer", "evidence", "explanation"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 4 },
          "type": { "enum": ["detail", "inference", "main_idea", "speaker_attitude", "purpose"] },
          "question": { "type": "string", "minLength": 1, "maxLength": 600 },
          "options": {
            "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 600 }
          },
          "correct_answer": { "type": "integer", "minimum": 0, "maximum": 3 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 3000 }
        }
      }
    }
  }
}
