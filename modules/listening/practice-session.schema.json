{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal PracticeSession v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "settings", "passage", "questions"],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "settings": { "$ref": "#/$defs/settings" },
    "passage": { "$ref": "#/$defs/passage" },
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": { "$ref": "#/$defs/question" }
      }
  },
  "allOf": [
    {
      "if": { "properties": { "settings": { "required": ["mode"], "properties": { "mode": { "const": "dialogue" } } } } },
      "then": { "properties": { "passage": { "properties": { "turns": { "items": { "$ref": "#/$defs/dialogueTurn" } } } } } }
    },
    {
      "if": { "properties": { "settings": { "required": ["mode"], "properties": { "mode": { "const": "monologue" } } } } },
      "then": { "properties": { "passage": { "properties": { "turns": { "items": { "$ref": "#/$defs/monologueTurn" } } } } } }
    }
  ],
  "$defs": {
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["difficulty", "question_count", "target_wpm", "topic", "mode"],
      "properties": {
        "difficulty": { "enum": ["CET-4", "CET-6", "TEM-8"] },
        "question_count": { "type": "integer", "minimum": 1, "maximum": 4 },
        "target_wpm": { "type": "integer", "minimum": 120, "maximum": 220 },
        "topic": { "type": "string", "maxLength": 120 },
        "mode": { "enum": ["monologue", "dialogue"] }
      }
    },
    "turn": {
      "type": "object", "additionalProperties": false,
      "required": ["speaker", "text"],
      "properties": {
        "speaker": { "enum": ["narrator", "male", "female"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 10000 }
      }
    },
    "passage": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "turns"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "turns": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/turn" } }
      }
    },
    "dialogueTurn": {
      "allOf": [
        { "$ref": "#/$defs/turn" },
        { "properties": { "text": { "maxLength": 1000 } } }
      ]
    },
    "monologueTurn": { "$ref": "#/$defs/turn" },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "speaker", "turn"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "speaker": { "enum": ["narrator", "male", "female"] },
        "turn": { "type": "integer", "minimum": 0, "maximum": 23 }
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "question", "options", "correct_answer", "evidence", "explanation"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 4 },
        "type": { "enum": ["detail", "inference", "main_idea", "speaker_attitude", "purpose"] },
        "question": { "type": "string", "minLength": 1, "maxLength": 600 },
        "options": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 600 } },
        "correct_answer": { "type": "integer", "minimum": 0, "maximum": 3 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 3000 }
      }
    },
    "auditResult": {
      "type": "object", "additionalProperties": false,
      "required": ["valid", "reason"],
      "properties": { "valid": { "type": "boolean" }, "reason": { "type": "string" } }
    }
  }
}
